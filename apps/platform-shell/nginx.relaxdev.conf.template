map $http_x_request_id $prom_request_id {
    default $http_x_request_id;
    "" $request_id;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    set $access_backend ${PLATFORM_ACCESS_UPSTREAM};
    set $projects_backend ${PLATFORM_PROJECTS_UPSTREAM};
    client_max_body_size 12m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_ssl_server_name on;

    include /etc/nginx/relaxdev.headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/access/v1/ {
        client_max_body_size 1m;
        rewrite ^/api/access/v1/(.*)$ /api/v1/$1 break;
        proxy_pass $access_backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $prom_request_id;
    }

    location = /.well-known/jwks.json {
        proxy_pass $access_backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $prom_request_id;
    }

    location /api/projects/v1/ {
        rewrite ^/api/projects/v1/(.*)$ /api/v1/$1 break;
        proxy_pass $projects_backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $prom_request_id;
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location = /index.html {
        include /etc/nginx/relaxdev.headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
